{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pocketpets",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "pocketpets.entangleit.com", "custom_domain": true },
    // Legacy portfolio links: the Pages deploy no longer serves /pocketpets.
    { "pattern": "entangleit.com/pocketpets", "zone_name": "entangleit.com" },
    { "pattern": "entangleit.com/pocketpets/*", "zone_name": "entangleit.com" }
  ],
  // Static assets are the SPA built with base `/` (npm run build:subdomain);
  // the portfolio build keeps its own /pocketpets/ base for scripts/deploy-entangleit.sh.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The worker owns the SPA fallback so missing assets 404 honestly
    // (a stale chunk must fail loudly, not receive text/html with a 200).
    "not_found_handling": "none"
  }
}
